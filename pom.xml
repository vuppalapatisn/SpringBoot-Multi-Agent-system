<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.vuppalapatisn.agentic</groupId>
    <artifactId>springboot-multi-agent-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Spring Boot Agentic AI Reference (CFG-First)</name>
    <description>
        Reference implementation of CFG-first agentic design on Spring Boot 4 and Spring AI 2.x.
        Nine standalone projects over one domain (Refund Desk), comparing workflow, state machine,
        agent and multi-agent architectures.
    </description>
    <url>https://github.com/vuppalapatisn/SpringBoot-Multi-Agent-system</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!--
        Aggregator only. Each module declares spring-boot-starter-parent as its parent so that
        every project remains standalone: you can copy one directory out of this repo and it
        still builds and runs on its own. That is deliberate.
    -->
    <modules>
        <module>01-chatclient-foundation</module>
        <module>02-tool-calling-guardrails</module>
        <module>03-rag-grounded-answers</module>
        <module>04-mcp-server-tools</module>
        <module>05-mcp-client-agent</module>
        <module>06-workflow-orchestration</module>
        <module>07-state-machine-orchestration</module>
        <module>08-autonomous-agent-loop</module>
        <module>09-multi-agent-supervisor</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>4.0.8</spring-boot.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
