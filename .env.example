# Copy to .env and fill in ONE provider. .env is gitignored.
#
#   cp .env.example .env
#
# Nothing in src/main is provider-specific: every ChatClient is built with the neutral
# ChatOptions.builder(), so switching provider is configuration, not a code change.
# Only the selected provider's key is required - the other can stay commented out.


# ---------------------------------------------------------------- Anthropic (default)
AI_CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-replace-me
# Key from https://console.anthropic.com/ -> API Keys


# ---------------------------------------------------------------- Google Gemini
# Comment out the two Anthropic lines above and uncomment these.
#
# AI_CHAT_PROVIDER=google-genai
# GEMINI_API_KEY=AIza-replace-me
# Key from https://aistudio.google.com/apikey  (Gemini Developer API)
#
# Optional. Default is gemini-2.5-flash, the broadly available fast tier.
# gemini-2.5-pro suits planner and supervisor roles; 3.x names exist but availability
# varies by account.
# GEMINI_MODEL=gemini-2.5-flash
#
# For Vertex AI instead of the Gemini Developer API, drop GEMINI_API_KEY and set:
# SPRING_AI_GOOGLE_GENAI_VERTEXAI=true
# SPRING_AI_GOOGLE_GENAI_PROJECTID=your-gcp-project
# SPRING_AI_GOOGLE_GENAI_LOCATION=europe-west1
# ...plus application-default credentials mounted into the container.


# ---------------------------------------------------------------- Kill switches (optional)
# Project 02: EXECUTE | DRY_RUN | DISABLED
# AGENTIC_TOOLS_EXECUTIONMODE=EXECUTE
#
# Project 04: false stops refunds; reads keep working.
# AGENTIC_MCPSERVER_EXECUTIONENABLED=true
